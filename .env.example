# Bot Token [Required]
BOT_TOKEN=

# Mongo Database Connection String [Required]
MONGO_CONNECTION=

# Recommended when telemetry is enabled. Generate once with:
# openssl rand -base64 48
# Keep it stable so daily active-user hashes remain consistent across restarts.
TELEMETRY_HASH_SALT=

# Optional io.net AI provider, also used for /ask and ticket summaries.
# Use a newly issued token and never commit a real value.
IO_INTELLIGENCE_API_KEY=
IO_INTELLIGENCE_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
IO_INTELLIGENCE_TIMEOUT_MS=30000
IO_INTELLIGENCE_CONCURRENCY=2
IO_INTELLIGENCE_CALLS_PER_MINUTE=20

# Required when SLAYNODE.enabled=true. Generate once with:
# openssl rand -base64 48
# Keep the same value across deploys or existing worker credentials cannot be decrypted.
SLAYNODE_MASTER_KEY=

# Webhooks [Optional]
ERROR_LOGS=
JOIN_LEAVE_LOGS=
# Preferred unified destination for bot errors and guild join/leave logs.
# The bot only needs Send Messages and Embed Links in this channel.
BOT_LOG_CHANNEL=

# Dashboard [Required for dashboard]
BOT_SECRET=
SESSION_PASSWORD=

# Required for Weather Command (https://weatherstack.com)
WEATHERSTACK_KEY=

# Required for image commands (https://strangeapi.fun/docs)
STRANGE_API_KEY=

# Required for Twitch alerts in /feeds (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional for GitHub alerts in /feeds: only raises the API rate limit
GITHUB_TOKEN=

# SPOTFIY [Required for Spotify Support]
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional private Lavalink node on 127.0.0.1:2333.
# When set, the bot prefers it and keeps configured public nodes as fallbacks.
LAVALINK_LOCAL_PASSWORD=

# Image analysis goes to an OpenAI-compatible endpoint. Set exactly one key and
# the matching provider is used; without any key the bot falls back to the local
# ONNX model, which is free but runs on your own CPU.
#
#   GEMINI_API_KEY      Google AI Studio — free, but refuses requests from
#                       unsupported countries ("User location is not supported")
#   CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID
#                       Cloudflare Workers AI — 10k neurons/day free
#   MISTRAL_API_KEY     Mistral — free Experiment tier, Pixtral reads images
#   OPENROUTER_API_KEY  OpenRouter — free models, 50 requests/day until topped up
#   IO_INTELLIGENCE_API_KEY  io.net — paid per token
#
# On free tiers providers commonly reserve the right to train on what you send.
# These requests carry members' images, so pick the provider accordingly.
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Override the automatic choice, or point at any other compatible endpoint.
# IMAGE_AI_PROVIDER=gemini
# IMAGE_AI_BASE_URL=https://example.com/v1
# IMAGE_AI_API_KEY=
# IMAGE_AI_MODEL=
# Route provider calls through a proxy. Needed where the provider refuses the
# server's location rather than the key. http(s) and socks are both accepted.
# IMAGE_AI_PROXY=http://user:pass@host:port
# Override the model used for the verdict and for reading text, if the
# provider's default is not what you want.
# IMAGE_SPAM_REMOTE_MODEL=
# IMAGE_SPAM_OCR_MODEL=
IMAGE_SPAM_REMOTE_TIMEOUT_MS=45000
IMAGE_SPAM_OCR_TIMEOUT_MS=45000
# How many prepared regions are transcribed. The model reads the full frame, so
# raising this mostly buys duplicate words at the price of extra requests.
IMAGE_SPAM_OCR_REGIONS=1

# The local model, used when no provider is configured and whenever the
# configured one fails. Runs in a worker thread so images never block the bot.
# Default is the 500M SmolVLM for responsive CPU-only moderation.
IMAGE_SPAM_VISION_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
# Weight precision: q4 (default, lightest) | int8 | q4f16 | fp16 (heaviest, most accurate).
IMAGE_SPAM_VISION_DTYPE=q4
# Split collages into panels for the vision model (default true). Set false to disable.
IMAGE_SPAM_VISION_SPLIT=true
# Cap ONNX native threads so inference cannot starve the Discord gateway.
# Defaults to half of the CPUs available to the process.
IMAGE_SPAM_ONNX_THREADS=4
# Full-frame inference still uses SmolVLM image splitting. Additional regions
# are ranked by OCR risk; lower this on shared CPU-only bot hosts.
IMAGE_SPAM_VISION_MAX_REGIONS=2
IMAGE_SPAM_MODEL_CACHE=.cache/image-spam

# Smart Invites use the SMART_INVITES section in config.js. No additional
# secret is required; publish the configured local port through HTTPS.
SMART_INVITES_ENABLED=false
SMART_INVITES_BASE_URL=https://slaybot.televibe.host
SMART_INVITES_HOST=127.0.0.1
SMART_INVITES_OFFICIAL_GUILD_ID=
