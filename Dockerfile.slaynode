FROM node:22-alpine AS dependencies
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY slaynode ./slaynode
COPY bot.js jsconfig.json ./
RUN addgroup -g 1001 -S slaynode && adduser -S slaynode -u 1001 -G slaynode && chown -R slaynode:slaynode /app
USER slaynode
ENV NODE_ENV=production
CMD ["node", "slaynode/worker.js"]
