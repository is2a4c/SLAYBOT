{
  "name": "slaybot",
  "version": "2.1.0",
  "description": "SLAYBOT is a powerful and flexible Discord bot with automatic moderation and more than 50 commands. The main focus is on security, server management, and advanced functionality.",
  "main": "bot.js",
  "author": "isaac",
  "license": "Other",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon .",
    "start": "node .",
    "lint": "eslint . --ext .js --max-warnings=0",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.js\" --ignore-unknown",
    "docker:build": "docker build -t slaybot .",
    "docker:run": "docker compose up -d",
    "docker:stop": "docker compose down",
    "debug:load": "node --trace-warnings scripts/debug-load.js",
    "runtime:check": "node scripts/check-runtime-config.js",
    "image-spam:check": "node scripts/check-image-spam.js",
    "image-spam:model:download": "node scripts/download-image-spam-model.js",
    "image-spam:e2e": "node scripts/check-image-spam-e2e.js",
    "test": "node --test test/*.test.js",
    "music:check": "node scripts/check-music-queue.js"
  },
  "homepage": "https://github.com/PashaBritva/SLAYBOT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PashaBritva/SLAYBOT.git"
  },
  "bugs": {
    "url": "https://github.com/PashaBritva/SLAYBOT/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lavaclient/queue": "^2.1.1",
    "@lavaclient/spotify": "^3.1.0",
    "@lavaclient/types": "^2.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "ascii-table": "0.0.9",
    "btoa": "^1.2.1",
    "common-tags": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "country-emoji-languages": "^1.0.1",
    "discord-giveaways": "^4.4.3",
    "discord-together": "^1.3.31",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "enhanced-ms": "^2.3.0",
    "express": "^4.22.2",
    "express-session": "^1.18.1",
    "fixedsize-map": "^1.1.0",
    "global-agent": "^4.1.3",
    "iso-639-1": "^3.1.4",
    "lavaclient": "^5.0.0-rc.6",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "mongoose": "^8.9.5",
    "nekos.life": "^3.0.0",
    "node-fetch": "^2.7.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "pretty-ms": "^7.0.1",
    "shadowsocks": "^1.5.3",
    "sharp": "^0.34.3",
    "snakecord": "^1.0.9",
    "socks-proxy-agent": "^10.0.0",
    "sourcebin_js": "^0.0.3-ignore",
    "string-progressbar": "^1.0.4",
    "table": "^6.9.0",
    "tesseract.js": "^7.0.0",
    "timestamp-to-date": "^1.1.0",
    "twemoji-parser": "^14.0.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "erlpack": "^0.1.4",
    "utf-8-validate": "^6.0.5",
    "zlib-sync": "^0.1.9"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^46.10.1",
    "node": "^18.20.6",
    "nodemon": "^3.1.9",
    "prettier": "3.4.2"
  },
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "open-source",
    "bot",
    "slaybot"
  ],
  "_moduleAliases": {
    "@root": ".",
    "@src": "src/",
    "@handlers": "src/handlers/",
    "@helpers": "src/helpers/",
    "@schemas": "src/database/schemas/",
    "@structures": "src/structures/"
  }
}
