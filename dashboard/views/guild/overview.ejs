<%- include("../partials/head", { title, guild }) %>
<h1><%= guild.name %></h1>
<p class="hint"><%= t("overview.idAndMembers", { id: guild.id, count: guild.memberCount }) %></p>

<% if (attention.length > 0) { %>
  <div class="attention">
    <h2><%= t("overview.attention") %></h2>
    <ul>
      <% attention.forEach((item) => { %><li><%= item %></li><% }) %>
    </ul>
  </div>
<% } %>

<div class="cards">
  <div class="card"><div class="label"><%= t("overview.members") %></div><div class="value"><%= counters.members %></div></div>
  <div class="card"><div class="label"><%= t("overview.messages24h") %></div><div class="value"><%= counters.messages24h %></div></div>
  <div class="card"><div class="label"><%= t("overview.automod24h") %></div><div class="value"><%= counters.automodActions24h %></div></div>
  <div class="card"><div class="label"><%= t("overview.openTickets") %></div><div class="value"><%= counters.openTickets %></div></div>
  <div class="card"><div class="label"><%= t("overview.activeSmartInvites") %></div><div class="value"><%= counters.activeSmartInvites %></div></div>
  <div class="card"><div class="label"><%= t("overview.errors24h") %></div><div class="value"><%= counters.errors24h %></div></div>
</div>

<div class="btn-row">
  <% if (canGuild("config.edit")) { %><a class="btn secondary" href="<%= basePath %>/g/<%= guild.id %>/config"><%= t("nav.config") %></a><% } %>
  <% if (canGuild("automod.edit")) { %><a class="btn secondary" href="<%= basePath %>/g/<%= guild.id %>/automod">Automod</a><% } %>
  <% if (canGuild("diagnostics.run")) { %><a class="btn secondary" href="<%= basePath %>/g/<%= guild.id %>/diagnostics"><%= t("nav.diagnostics") %></a><% } %>
</div>
<%- include("../partials/foot") %>
