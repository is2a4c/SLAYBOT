<%- include("../partials/head", { title, guild }) %>
<h1><%= user.username %></h1>
<p class="hint">ID: <%= user.id %> <% if (isBanned) { %><span class="badge fail"><%= t("member.banned") %></span><% } %></p>

<% if (error) { %><div class="error-banner"><%= error %></div><% } %>

<div class="cards">
  <div class="card"><div class="label"><%= t("member.warnings") %></div><div class="value"><%= memberDb.warnings %></div></div>
  <div class="card"><div class="label"><%= t("member.strikes") %></div><div class="value"><%= memberDb.strikes %></div></div>
  <div class="card"><div class="label"><%= t("member.inGuild") %></div><div class="value"><%= member ? t("common.yes") : t("common.no") %></div></div>
  <% if (member) { %>
    <div class="card"><div class="label"><%= t("member.joined") %></div><div class="value" style="font-size:14px"><%= member.joinedAt ? formatDate(member.joinedAt) : t("common.none") %></div></div>
  <% } %>
</div>

<% if (member) { %>
  <div class="panel">
    <strong><%= t("member.rolesLabel") %></strong>
    <%= member.roles.cache.filter((r) => r.id !== guild.id).map((r) => r.name).join(", ") || t("common.none") %>
  </div>
<% } %>

<div class="panel">
  <h2 style="margin-top:0"><%= t("member.moderationHeading") %></h2>
  <form method="post" action="<%= basePath %>/g/<%= guild.id %>/members/<%= user.id %>/actions">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field">
      <label for="action"><%= t("common.action") %></label>
      <select id="action" name="action">
        <% if (member) { %>
          <option value="warn"><%= t("member.warn") %></option>
          <option value="timeout">Timeout</option>
          <option value="kick">Kick</option>
        <% } %>
        <% if (isBanned) { %>
          <option value="unban"><%= t("member.unban") %></option>
        <% } else { %>
          <option value="ban">Ban</option>
        <% } %>
      </select>
    </div>
    <div class="field">
      <label for="durationMinutes"><%= t("member.timeoutDuration") %></label>
      <select id="durationMinutes" name="durationMinutes">
        <% Object.entries(timeoutOptions).forEach(([value, minutes]) => { %>
          <option value="<%= value %>"><%= minutes >= 1440 ? t("member.days", { count: Math.round(minutes / 1440) }) : t("member.minutes", { count: minutes }) %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="reason"><%= t("member.reasonRequired") %></label>
      <textarea id="reason" name="reason" rows="2" maxlength="480" required></textarea>
    </div>
    <button type="submit" class="btn danger"><%= t("common.apply") %></button>
  </form>
</div>

<h2><%= t("member.modlogHistory") %></h2>
<% if (modLogs.length === 0) { %>
  <div class="panel empty"><%= t("common.noEntries") %></div>
<% } else { %>
  <table>
    <thead><tr><th><%= t("common.time") %></th><th><%= t("common.type") %></th><th><%= t("common.moderator") %></th><th><%= t("common.reason") %></th></tr></thead>
    <tbody>
      <% modLogs.forEach((e) => { %>
        <tr>
          <td><%= formatDate(e.created_at) %></td>
          <td><%= e.type %></td>
          <td><%= e.admin?.tag || e.admin?.id %></td>
          <td><%= e.reason || t("common.none") %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include("../partials/foot") %>
