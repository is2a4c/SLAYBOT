<%- include("../partials/head", { title, guild }) %>
<header class="page-header"><div class="page-heading"><p class="eyebrow"><a href="<%= basePath %>/g/<%= guild.id %>/custom-commands"><%= t("common.back") %></a></p><h1><code><%= command.name %></code></h1><p class="subtitle"><%= t("customCommands.editSubtitle") %></p></div><span class="badge <%= command.enabled ? 'pass' : 'neutral' %>"><%= command.enabled ? t("customCommands.enabled") : t("customCommands.disabled") %></span></header>
<% if (error) { %><div class="error-banner"><%= error %></div><% } %>
<section class="panel"><h2><%= t("customCommands.settings") %></h2><form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="field"><label for="command-name"><%= t("customCommands.name") %></label><input id="command-name" name="name" value="<%= command.name %>" pattern="[a-z0-9_-]{1,32}" maxlength="32" required /></div><div class="field"><label for="command-group"><%= t("customCommands.group") %></label><input id="command-group" name="group" value="<%= command.group %>" maxlength="32" /></div><div class="field field-wide"><label for="command-description"><%= t("customCommands.description") %></label><input id="command-description" name="description" value="<%= command.description || '' %>" maxlength="100" /></div>
  <div class="field"><label for="command-cooldown"><%= t("customCommands.cooldown") %></label><input id="command-cooldown" type="number" name="cooldown" min="0" max="86400" value="<%= command.cooldown_seconds %>" /></div><label class="checkbox-field field"><input type="checkbox" name="enabled" <%= command.enabled ? "checked" : "" %> /><span><%= t("customCommands.enabled") %></span></label><label class="checkbox-field field"><input type="checkbox" name="deleteInvocation" <%= command.delete_invocation ? "checked" : "" %> /><span><%= t("customCommands.deleteInvocation") %></span></label>
  <div class="field"><label for="command-roles"><%= t("customCommands.allowedRoles") %></label><select id="command-roles" name="allowedRoles" multiple size="5"><% options.roles.forEach((role) => { %><option value="<%= role.id %>" <%= command.allowed_roles.includes(role.id) ? "selected" : "" %>>@<%= role.name %></option><% }) %></select></div><div class="field"><label for="command-channels"><%= t("customCommands.allowedChannels") %></label><select id="command-channels" name="allowedChannels" multiple size="5"><% options.channels.forEach((channel) => { %><option value="<%= channel.id %>" <%= command.allowed_channels.includes(channel.id) ? "selected" : "" %>>#<%= channel.name %></option><% }) %></select></div>
  <div class="field field-wide"><fieldset class="trigger-set"><legend><%= t("customCommands.triggers") %></legend>
    <label class="checkbox-field"><input type="checkbox" name="triggerPrefix" <%= command.triggers.prefix ? "checked" : "" %> /><span><%= t("customCommands.triggerPrefix") %></span></label>
    <label class="checkbox-field"><input type="checkbox" name="triggerSlash" <%= command.triggers.slash ? "checked" : "" %> /><span><%= t("customCommands.triggerSlash") %></span></label>
    <label class="checkbox-field"><input type="checkbox" name="triggerMessageContext" <%= command.triggers.message_context ? "checked" : "" %> /><span><%= t("customCommands.triggerMessageContext") %></span></label>
    <label class="checkbox-field"><input type="checkbox" name="triggerMemberContext" <%= command.triggers.member_context ? "checked" : "" %> /><span><%= t("customCommands.triggerMemberContext") %></span></label>
  </fieldset><p class="hint"><%= t("customCommands.triggersHint") %></p></div>
  <div class="field field-wide"><label for="command-context-label"><%= t("customCommands.contextLabel") %></label><input id="command-context-label" name="contextLabel" value="<%= command.context_label || '' %>" maxlength="32" placeholder="<%= command.name %>" /></div>
  <div class="field field-wide"><button class="btn" type="submit"><%= t("common.save") %></button></div></form></section>

<section class="panel"><div class="section-heading"><h2><%= t("customCommands.parameters") %></h2><span class="control-count"><%= command.subcommands.length ? t("customCommands.subcommandMode") : t("customCommands.rootMode") %></span></div>
  <p class="hint"><%= t("customCommands.parametersHint") %></p>

  <% if (!command.subcommands.length) { %>
    <% if (!command.options.length) { %><div class="empty"><%= t("customCommands.noParameters") %></div><% } else { %>
      <div class="stack-list"><% command.options.forEach((option) => { %>
        <div class="stack-row"><div><small><%= option.type %><%= option.required ? ` · ${t("customCommands.required")}` : "" %></small><strong><%= option.name %></strong><small><%= option.description %><%= option.choices.length ? ` · ${option.choices.map((choice) => choice.name).join(", ")}` : "" %></small></div>
          <form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/options/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="optionName" value="<%= option.name %>" /><button class="btn danger" type="submit"><%= t("common.delete") %></button></form></div>
      <% }) %></div>
    <% } %>
  <% } else { %>
    <div class="stack-list"><% command.subcommands.forEach((subcommand) => { %>
      <div class="stack-row"><div><small><%= t("customCommands.subcommand") %></small><strong><%= command.name %> <%= subcommand.name %></strong><small><%= subcommand.description %></small>
        <% subcommand.options.forEach((option) => { %>
          <form class="inline-form" method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/options/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="subcommand" value="<%= subcommand.name %>" /><input type="hidden" name="optionName" value="<%= option.name %>" /><small><%= option.name %><%= option.required ? "*" : "" %></small><button class="btn danger" type="submit"><%= t("common.delete") %></button></form>
        <% }) %></div>
        <form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/subcommands/delete" data-confirm="<%= t('common.dangerousAction') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="subcommandName" value="<%= subcommand.name %>" /><button class="btn danger" type="submit"><%= t("common.delete") %></button></form></div>
    <% }) %></div>
  <% } %>

  <form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/options" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field"><label for="option-name"><%= t("customCommands.parameterName") %></label><input id="option-name" name="optionName" pattern="[a-z0-9_-]{1,32}" maxlength="32" required /></div>
    <div class="field"><label for="option-type"><%= t("common.type") %></label><select id="option-type" name="optionType"><% Object.entries(optionTypes).forEach(([label, value]) => { %><option value="<%= value %>"><%= t(`customCommands.optionTypes.${label}`) %></option><% }) %></select></div>
    <div class="field field-wide"><label for="option-description"><%= t("customCommands.description") %></label><input id="option-description" name="optionDescription" maxlength="100" /></div>
    <div class="field"><label for="option-subcommand"><%= t("customCommands.subcommand") %></label><select id="option-subcommand" name="subcommand"><option value=""><%= t("customCommands.rootMode") %></option><% command.subcommands.forEach((subcommand) => { %><option value="<%= subcommand.name %>"><%= subcommand.name %></option><% }) %></select></div>
    <label class="checkbox-field field"><input type="checkbox" name="optionRequired" /><span><%= t("customCommands.required") %></span></label>
    <div class="field field-wide"><label for="option-choices"><%= t("customCommands.choices") %></label><textarea id="option-choices" name="choices" rows="3" placeholder="Small = 1"></textarea><div class="hint"><%= t("customCommands.choicesHint") %></div></div>
    <div class="field"><label for="option-min"><%= t("customCommands.optionMin") %></label><input id="option-min" type="number" name="optionMin" step="any" /></div>
    <div class="field"><label for="option-max"><%= t("customCommands.optionMax") %></label><input id="option-max" type="number" name="optionMax" step="any" /></div>
    <div class="field"><label for="option-min-length"><%= t("customCommands.optionMinLength") %></label><input id="option-min-length" type="number" name="optionMinLength" min="0" max="6000" /></div>
    <div class="field"><label for="option-max-length"><%= t("customCommands.optionMaxLength") %></label><input id="option-max-length" type="number" name="optionMaxLength" min="1" max="6000" /></div>
    <div class="field field-wide"><div class="hint"><%= t("customCommands.optionRangeHint") %></div></div>
    <div class="field field-wide"><button class="btn" type="submit"><%= t("customCommands.addParameter") %></button></div>
  </form>

  <form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/subcommands" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field"><label for="subcommand-name"><%= t("customCommands.subcommandName") %></label><input id="subcommand-name" name="subcommandName" pattern="[a-z0-9_-]{1,32}" maxlength="32" required /></div>
    <div class="field"><label for="subcommand-description"><%= t("customCommands.description") %></label><input id="subcommand-description" name="subcommandDescription" maxlength="100" /></div>
    <div class="field field-wide"><button class="btn" type="submit"><%= t("customCommands.addSubcommand") %></button></div>
  </form>
</section>

<section class="panel"><div class="section-heading"><h2><%= t("customCommands.actions") %></h2><span class="control-count"><%= command.actions.length %>/<%= maxActions %></span></div><% if (!command.actions.length) { %><div class="empty"><%= t("customCommands.noActions") %></div><% } else { %><div class="stack-list"><% command.actions.forEach((action, index) => {
  const confirming = action.type === "SHOW_MODAL" ? command.actions.find((entry) => entry.id === action.confirm_action_id) : null;
  const preview = action.poll?.question
    ? `📊 ${action.poll.question} · ${t("customCommands.pollOptionCount", { count: action.poll.options.length })}`
    : ["SEND_MESSAGE", "SEND_DM"].includes(action.type)
    ? [
        action.content || action.embed_title || action.embed_description || "",
        action.fields.length ? t("customCommands.fieldCount", { count: action.fields.length }) : "",
        action.buttons.length ? t("customCommands.buttonCount", { count: action.buttons.length }) : "",
      ].filter(Boolean).join(" · ").slice(0, 200)
    : action.type === "CHANGE_ROLES"
      ? `+${action.add_roles.length} / −${action.remove_roles.length}`
      : action.type === "SHOW_MODAL"
        ? `${action.modal_title} · ${t("customCommands.modalFieldCount", { count: action.modal_inputs.length })}${confirming ? ` → ${confirming.name}` : ` · ${t("customCommands.modalNoConfirm")}`}`
        : action.type === "SET_NICKNAME"
          ? action.nickname || t("customCommands.nicknameClears")
          : ["TIMEOUT_TARGET", "UNTIMEOUT_TARGET"].includes(action.type)
            ? action.type === "TIMEOUT_TARGET"
              ? `${action.duration_minutes} min${action.reason ? ` · ${action.reason}` : ""}`
              : action.reason || ""
            : action.emoji;
%><div class="stack-row"><div><small><%= index + 1 %> · <%= action.type %></small><strong><%= action.name %></strong><small><%= preview %></small></div><form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/actions/<%= action.id %>/delete" data-confirm="<%= t('common.dangerousAction') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn danger" type="submit"><%= t("common.delete") %></button></form></div><% }) %></div><% } %></section>

<section class="panel collection-create"><h2><%= t("customCommands.addAction") %></h2><p class="hint"><%= t("customCommands.variables") %></p><form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/actions" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="field"><label for="action-type"><%= t("common.type") %></label><select id="action-type" name="type"><option value="SEND_MESSAGE"><%= t("customCommands.sendMessage") %></option><option value="SEND_DM"><%= t("customCommands.sendDm") %></option><option value="CHANGE_ROLES"><%= t("customCommands.changeRoles") %></option><option value="ADD_REACTION"><%= t("customCommands.addReaction") %></option><option value="SET_NICKNAME"><%= t("customCommands.setNickname") %></option><option value="TIMEOUT_TARGET"><%= t("customCommands.timeoutTarget") %></option><option value="UNTIMEOUT_TARGET"><%= t("customCommands.untimeoutTarget") %></option><option value="SHOW_MODAL"><%= t("customCommands.showModal") %></option></select></div><div class="field"><label for="action-name"><%= t("customCommands.actionName") %></label><input id="action-name" name="actionName" maxlength="80" /></div>
  <div class="field"><label for="action-channel"><%= t("customCommands.outputChannel") %></label><select id="action-channel" name="channelId"><option value=""><%= t("customCommands.currentChannel") %></option><% options.channels.forEach((channel) => { %><option value="<%= channel.id %>">#<%= channel.name %></option><% }) %></select></div><div class="field"><label for="action-color"><%= t("customCommands.embedColor") %></label><input id="action-color" type="color" name="embedColor" value="#8b5cf6" /></div>
  <div class="field field-wide"><label for="action-content"><%= t("customCommands.content") %></label><textarea id="action-content" name="content" rows="3" maxlength="2000"></textarea></div><div class="field"><label for="action-title"><%= t("customCommands.embedTitle") %></label><input id="action-title" name="embedTitle" maxlength="256" /></div><div class="field field-wide"><label for="action-description"><%= t("customCommands.embedDescription") %></label><textarea id="action-description" name="embedDescription" rows="4" maxlength="4096"></textarea></div>
  <div class="field"><label for="action-author"><%= t("customCommands.embedAuthor") %></label><input id="action-author" name="embedAuthor" maxlength="256" /></div><div class="field"><label for="action-footer"><%= t("customCommands.embedFooter") %></label><input id="action-footer" name="embedFooter" maxlength="2048" /></div><label class="checkbox-field field"><input type="checkbox" name="embedTimestamp" /><span><%= t("customCommands.embedTimestamp") %></span></label>
  <div class="field"><label for="action-thumbnail"><%= t("customCommands.embedThumbnail") %></label><input id="action-thumbnail" name="embedThumbnail" maxlength="300" placeholder="https://" /></div><div class="field"><label for="action-image"><%= t("customCommands.embedImage") %></label><input id="action-image" name="embedImage" maxlength="300" placeholder="https://" /></div>
  <div class="field field-wide"><label for="action-fields"><%= t("customCommands.fields") %></label><textarea id="action-fields" name="fields" rows="3" placeholder="Rules | Read #rules first | inline"></textarea><div class="hint"><%= t("customCommands.fieldsHint") %></div></div>
  <div class="field field-wide"><label for="action-buttons"><%= t("customCommands.buttons") %></label><textarea id="action-buttons" name="buttons" rows="3" placeholder="Support | https://discord.gg/..."></textarea><div class="hint"><%= t("customCommands.buttonsHint") %></div></div>
  <div class="field"><label for="action-emoji"><%= t("customCommands.reactionEmoji") %></label><input id="action-emoji" name="emoji" maxlength="100" placeholder="✅" /></div><div class="field"><label for="action-delete-after"><%= t("customCommands.deleteAfter") %></label><input id="action-delete-after" type="number" name="deleteAfterSeconds" min="0" max="86400" value="0" /></div><label class="checkbox-field field"><input type="checkbox" name="tts" /><span><%= t("customCommands.tts") %></span></label>
  <div class="field"><label for="action-nickname"><%= t("customCommands.nickname") %></label><input id="action-nickname" name="nickname" maxlength="32" /><div class="hint"><%= t("customCommands.nicknameHint") %></div></div>
  <div class="field field-wide"><hr /><p class="hint"><%= t("customCommands.targetActionHint") %></p></div>
  <div class="field"><label for="action-duration"><%= t("customCommands.timeoutDuration") %></label><input id="action-duration" type="number" name="durationMinutes" min="1" max="40320" value="10" /></div>
  <div class="field field-wide"><label for="action-reason"><%= t("customCommands.timeoutReason") %></label><input id="action-reason" name="reason" maxlength="500" /></div>
  <div class="field"><label for="action-mention-roles"><%= t("customCommands.mentionRoles") %></label><select id="action-mention-roles" name="mentionRoles" multiple size="5"><% options.roles.forEach((role) => { %><option value="<%= role.id %>">@<%= role.name %></option><% }) %></select></div>
  <div class="field"><label for="action-add-roles"><%= t("ranking.addRoles") %></label><select id="action-add-roles" name="addRoles" multiple size="5"><% options.roles.forEach((role) => { %><option value="<%= role.id %>">@<%= role.name %></option><% }) %></select></div><div class="field"><label for="action-remove-roles"><%= t("ranking.removeRoles") %></label><select id="action-remove-roles" name="removeRoles" multiple size="5"><% options.roles.forEach((role) => { %><option value="<%= role.id %>">@<%= role.name %></option><% }) %></select></div>
  <div class="field field-wide"><hr /><p class="hint"><%= t("customCommands.pollHint") %></p></div>
  <div class="field field-wide"><label for="action-poll-question"><%= t("customCommands.pollQuestion") %></label><input id="action-poll-question" name="pollQuestion" maxlength="300" /></div>
  <div class="field field-wide"><label for="action-poll-options"><%= t("customCommands.pollOptions") %></label><textarea id="action-poll-options" name="pollOptions" rows="3" placeholder="Yes&#10;No"></textarea></div>
  <label class="checkbox-field field"><input type="checkbox" name="pollMulti" /><span><%= t("customCommands.pollMulti") %></span></label>
  <div class="field"><label for="action-poll-duration"><%= t("customCommands.pollDuration") %></label><input id="action-poll-duration" type="number" name="pollDuration" min="1" /></div>
  <div class="field field-wide"><hr /><p class="hint"><%= t("customCommands.modalHint") %></p></div>
  <div class="field field-wide"><label for="action-modal-title"><%= t("customCommands.modalTitle") %></label><input id="action-modal-title" name="modalTitle" maxlength="45" /></div>
  <div class="field"><label for="action-confirm"><%= t("customCommands.modalConfirmAction") %></label><select id="action-confirm" name="confirmAction"><option value=""><%= t("customCommands.modalNoConfirm") %></option><% command.actions.filter((entry) => entry.type !== "SHOW_MODAL").forEach((entry) => { %><option value="<%= entry.id %>"><%= entry.name %></option><% }) %></select></div>
  <div class="field field-wide"><label for="action-modal-inputs"><%= t("customCommands.modalFields") %></label><textarea id="action-modal-inputs" name="modalInputs" rows="4" placeholder="color | Favourite colour | short | required | | | e.g. blue"></textarea><div class="hint"><%= t("customCommands.modalFieldsHint", { count: maxModalInputs }) %></div></div>
  <div class="field field-wide"><button class="btn" type="submit"><%= t("common.add") %></button></div>
</form></section>
<form method="post" action="<%= basePath %>/g/<%= guild.id %>/custom-commands/<%= command._id %>/delete" data-confirm="<%= t('common.dangerousAction') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn danger" type="submit"><%= t("customCommands.deleteCommand") %></button></form>
<%- include("../partials/foot") %>
