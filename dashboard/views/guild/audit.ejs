<%- include("../partials/head", { title, guild }) %>
<header class="page-header"><div class="page-heading">
  <p class="eyebrow"><%= t("nav.observability") %></p>
  <h1><%= t("audit.guildTitle") %></h1>
  <p class="subtitle"><%= t("audit.guildHint") %></p>
</div></header>

<% if (entries.length === 0) { %>
  <div class="panel empty"><%= t("common.noEntries") %></div>
<% } else { %>
  <div class="table-shell"><table>
    <thead><tr><th><%= t("common.time") %></th><th><%= t("common.action") %></th><th><%= t("common.who") %></th><th><%= t("common.target") %></th><th><%= t("common.reason") %></th></tr></thead>
    <tbody>
      <% entries.forEach((e) => { %>
        <tr>
          <td><%= formatDate(e.created_at) %></td>
          <td><%= e.action %></td>
          <td><%= e.actorTag %> (<%= e.actorId %>)</td>
          <td><%= e.targetType || t("common.none") %><% if (e.targetId) { %> · <%= e.targetId %><% } %></td>
          <td><%= e.reason || t("common.none") %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>
<%- include("../partials/foot") %>
