<%- include("../partials/head", { title, guild }) %>
<header class="page-header"><div class="page-heading">
  <p class="eyebrow"><%= t("nav.observability") %></p>
  <h1><%= t("audit.guildTitle") %></h1>
  <p class="subtitle"><%= t("audit.guildHint") %></p>
</div></header>

<form class="panel command-toolbar" method="get" action="<%= basePath %>/g/<%= guild.id %>/audit">
  <div class="field command-search"><label for="audit-search"><%= t("audit.search") %></label><input id="audit-search" name="search" value="<%= filters.search %>" maxlength="80" /></div>
  <div class="field"><label for="audit-action"><%= t("common.action") %></label><input id="audit-action" name="action" value="<%= filters.action %>" maxlength="100" /></div>
  <div class="field"><label for="audit-actor"><%= t("audit.actorId") %></label><input id="audit-actor" name="actorId" value="<%= filters.actorId %>" maxlength="20" /></div>
  <div class="field"><label for="audit-target"><%= t("audit.targetType") %></label><input id="audit-target" name="targetType" value="<%= filters.targetType %>" maxlength="100" /></div>
  <button class="btn" type="submit"><%= t("common.filter") %></button>
  <% if (canGuild("audit.export")) { const exportQuery = new URLSearchParams(filters).toString(); %><a class="btn secondary" href="<%= basePath %>/g/<%= guild.id %>/audit/export.csv?<%= exportQuery %>"><%= t("audit.exportCsv") %></a><% } %>
</form>

<% if (entries.length === 0) { %>
  <div class="panel empty"><%= t("common.noEntries") %></div>
<% } else { %>
  <div class="table-shell"><table>
    <thead><tr><th><%= t("common.time") %></th><th><%= t("common.action") %></th><th><%= t("common.who") %></th><th><%= t("common.target") %></th><th><%= t("common.reason") %></th></tr></thead>
    <tbody>
      <% entries.forEach((e) => { %>
        <tr>
          <td><%= formatDate(e.created_at) %></td>
          <td><%= e.action %></td>
          <td><%= e.actorTag %> (<%= e.actorId %>)</td>
          <td><%= e.targetType || t("common.none") %><% if (e.targetId) { %> · <%= e.targetId %><% } %></td>
          <td><%= e.reason || t("common.none") %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>
<%- include("../partials/foot") %>
