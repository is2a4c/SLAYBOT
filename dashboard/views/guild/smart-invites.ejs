<%- include("../partials/head", { title, guild }) %>
<header class="page-header"><div class="page-heading">
  <p class="eyebrow"><%= t("nav.management") %></p>
  <h1><%= t("smartInvites.title") %></h1>
  <p class="subtitle"><%= t("smartInvites.subtitle") %></p>
</div></header>

<% if (error) { %><div class="error-banner"><%= error %></div><% } %>
<% if (!enabled) { %><div class="error-banner"><%= t("smartInvites.disabled") %></div><% } %>

<% if (records.length === 0) { %>
  <div class="panel empty"><%= t("smartInvites.empty") %></div>
<% } else { %>
  <div class="table-shell"><table>
    <thead><tr><th><%= t("smartInvites.slug") %></th><th><%= t("common.channel") %></th><th><%= t("common.status") %></th><th><%= t("smartInvites.clicks") %></th><th><%= t("smartInvites.joins") %></th><th></th></tr></thead>
    <tbody>
      <% records.forEach((r) => { %>
        <tr>
          <td><a href="<%= r.publicUrl %>" target="_blank" rel="noopener"><%= r.slug %></a></td>
          <td>#<%= (guild.channels.cache.get(r.channelId) || {}).name || r.channelId %></td>
          <td><%= r.status %></td>
          <td><%= r.clickCount %></td>
          <td><%= r.joinButtonClickCount %></td>
          <td class="btn-row">
            <form method="post" action="<%= basePath %>/g/<%= guild.id %>/smart-invites/<%= r.slug %>/refresh">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn secondary"><%= t("common.refresh") %></button>
            </form>
            <form method="post" action="<%= basePath %>/g/<%= guild.id %>/smart-invites/<%= r.slug %>/delete" data-confirm="<%= t("common.dangerousAction") %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn danger"><%= t("common.delete") %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>

<div class="panel">
  <h2 style="margin-top:0"><%= t("smartInvites.createHeading") %></h2>
  <form method="post" action="<%= basePath %>/g/<%= guild.id %>/smart-invites">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field">
      <label for="slug"><%= t("smartInvites.slug") %></label>
      <input type="text" id="slug" name="slug" required />
    </div>
    <div class="field">
      <label for="channelId"><%= t("common.channel") %></label>
      <select id="channelId" name="channelId" required>
        <% textChannels.forEach((c) => { %><option value="<%= c.id %>">#<%= c.name %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="description"><%= t("smartInvites.description") %></label>
      <input type="text" id="description" name="description" maxlength="200" />
    </div>
    <button type="submit" class="btn"><%= t("common.create") %></button>
  </form>
</div>
<%- include("../partials/foot") %>
