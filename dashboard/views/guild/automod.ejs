<%- include("../partials/head", { title, guild }) %>
<header class="page-header"><div class="page-heading">
  <p class="eyebrow"><%= t("nav.management") %></p>
  <h1><%= t("automod.title") %></h1>
  <p class="subtitle"><%= t("automod.subtitle") %></p>
</div></header>

<form class="panel" method="post" action="<%= basePath %>/g/<%= guild.id %>/automod">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="panel-header"><h2><%= t("automod.enforcementHeading") %></h2><p class="hint"><%= t("automod.saveHint") %></p></div>

  <div class="form-grid">
  <div class="field">
    <label for="action"><%= t("automod.action") %></label>
    <select id="action" name="action">
      <% validActions.forEach((a) => { %>
        <option value="<%= a %>" <%= settings.automod.action === a ? "selected" : "" %>><%= a %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="strikes"><%= t("automod.strikes") %></label>
    <input type="number" id="strikes" name="strikes" min="1" max="100" value="<%= settings.automod.strikes %>" />
  </div>
  </div>

  <h2><%= t("automod.rulesHeading") %></h2>
  <div class="toggle-grid">
  <div class="checkbox-field field">
    <input type="checkbox" id="anti_links" name="anti_links" <%= settings.automod.anti_links ? "checked" : "" %> />
    <label for="anti_links">Anti-links</label>
  </div>
  <div class="checkbox-field field">
    <input type="checkbox" id="anti_invites" name="anti_invites" <%= settings.automod.anti_invites ? "checked" : "" %> />
    <label for="anti_invites">Anti-invites</label>
  </div>
  <div class="checkbox-field field">
    <input type="checkbox" id="anti_attachments" name="anti_attachments" <%= settings.automod.anti_attachments ? "checked" : "" %> />
    <label for="anti_attachments">Anti-attachments</label>
  </div>
  <div class="checkbox-field field">
    <input type="checkbox" id="anti_spam" name="anti_spam" <%= settings.automod.anti_spam ? "checked" : "" %> />
    <label for="anti_spam">Anti-spam</label>
  </div>
  <div class="checkbox-field field">
    <input type="checkbox" id="anti_ghostping" name="anti_ghostping" <%= settings.automod.anti_ghostping ? "checked" : "" %> />
    <label for="anti_ghostping">Anti-ghostping</label>
  </div>
  <div class="checkbox-field field">
    <input type="checkbox" id="anti_image_spam" name="anti_image_spam" <%= settings.automod.anti_image_spam ? "checked" : "" %> />
    <label for="anti_image_spam">Image Spam Guard</label>
  </div>
  <div class="checkbox-field field">
    <input type="checkbox" id="debug" name="debug" <%= settings.automod.debug ? "checked" : "" %> />
    <label for="debug"><%= t("automod.debug") %></label>
  </div>
  </div>
  <div class="field">
    <label for="image_spam_threshold"><%= t("automod.imageSpamThreshold") %></label>
    <input type="number" id="image_spam_threshold" name="image_spam_threshold" min="50" max="100" value="<%= settings.automod.image_spam_threshold %>" />
  </div>

  <h2><%= t("automod.limitsHeading") %></h2>
  <div class="field">
    <label for="anti_massmention"><%= t("automod.antiMassmention") %></label>
    <input type="number" id="anti_massmention" name="anti_massmention" min="0" max="50" value="<%= settings.automod.anti_massmention || 0 %>" />
  </div>
  <div class="field">
    <label for="max_lines"><%= t("automod.maxLines") %></label>
    <input type="number" id="max_lines" name="max_lines" min="0" max="50" value="<%= settings.automod.max_lines || 0 %>" />
  </div>
  <div class="field">
    <label for="max_mentions"><%= t("automod.maxMentions") %></label>
    <input type="number" id="max_mentions" name="max_mentions" min="1" max="50" value="<%= settings.automod.max_mentions %>" />
  </div>
  <div class="field">
    <label for="max_role_mentions"><%= t("automod.maxRoleMentions") %></label>
    <input type="number" id="max_role_mentions" name="max_role_mentions" min="0" max="20" value="<%= settings.automod.max_role_mentions %>" />
  </div>

  <h2><%= t("automod.contentFiltersHeading") %></h2>
  <div class="toggle-grid">
    <div class="checkbox-field field"><input type="checkbox" id="filter_enabled" name="filter_enabled" <%= settings.automod.filter_enabled ? "checked" : "" %> /><label for="filter_enabled"><%= t("automod.filterEnabled") %></label></div>
    <div class="checkbox-field field"><input type="checkbox" id="filter_case_sensitive" name="filter_case_sensitive" <%= settings.automod.filter_case_sensitive ? "checked" : "" %> /><label for="filter_case_sensitive"><%= t("automod.filterCaseSensitive") %></label></div>
    <div class="checkbox-field field"><input type="checkbox" id="filter_delete" name="filter_delete" <%= settings.automod.filter_delete !== false ? "checked" : "" %> /><label for="filter_delete"><%= t("automod.filterDelete") %></label></div>
  </div>
  <div class="form-grid">
    <div class="field field-wide"><label for="filter_terms"><%= t("automod.filterTerms") %></label><textarea id="filter_terms" name="filter_terms" rows="5" maxlength="4000"><%= settings.automod.filter_terms || "" %></textarea><div class="hint"><%= t("automod.filterListHint") %></div></div>
    <div class="field field-wide"><label for="filter_exceptions"><%= t("automod.filterExceptions") %></label><textarea id="filter_exceptions" name="filter_exceptions" rows="3" maxlength="4000"><%= settings.automod.filter_exceptions || "" %></textarea></div>
    <div class="field"><label for="filter_match_mode"><%= t("automod.filterMode") %></label><select id="filter_match_mode" name="filter_match_mode"><% ["CONTAINS", "WORD", "EXACT"].forEach((entry) => { %><option value="<%= entry %>" <%= settings.automod.filter_match_mode === entry ? "selected" : "" %>><%= t(`automod.filterModes.${entry}`) %></option><% }) %></select></div>
    <div class="field"><label for="filter_strikes"><%= t("automod.filterStrikes") %></label><input type="number" id="filter_strikes" name="filter_strikes" min="0" max="10" value="<%= settings.automod.filter_strikes ?? 1 %>" /></div>
  </div>

  <h2><%= t("automod.linkFiltersHeading") %></h2>
  <div class="form-grid">
    <div class="field"><label for="link_mode"><%= t("automod.linkMode") %></label><select id="link_mode" name="link_mode"><% ["ALL", "ALLOWLIST", "BLOCKLIST"].forEach((entry) => { %><option value="<%= entry %>" <%= settings.automod.link_mode === entry ? "selected" : "" %>><%= t(`automod.linkModes.${entry}`) %></option><% }) %></select></div>
    <div class="field field-wide"><label for="link_domains"><%= t("automod.linkDomains") %></label><textarea id="link_domains" name="link_domains" rows="3" maxlength="4000"><%= settings.automod.link_domains || "" %></textarea></div>
    <div class="field field-wide"><label for="allowed_invite_codes"><%= t("automod.allowedInviteCodes") %></label><textarea id="allowed_invite_codes" name="allowed_invite_codes" rows="3" maxlength="4000"><%= settings.automod.allowed_invite_codes || "" %></textarea></div>
  </div>

  <h2><%= t("automod.spamTuningHeading") %></h2>
  <div class="form-grid">
    <div class="field"><label for="spam_window_seconds"><%= t("automod.spamWindow") %></label><input type="number" id="spam_window_seconds" name="spam_window_seconds" min="1" max="300" value="<%= settings.automod.spam_window_seconds ?? 3 %>" /></div>
    <div class="field"><label for="spam_max_repeats"><%= t("automod.spamRepeats") %></label><input type="number" id="spam_max_repeats" name="spam_max_repeats" min="2" max="20" value="<%= settings.automod.spam_max_repeats ?? 2 %>" /></div>
  </div>

  <h2><%= t("automod.whitelistHeading") %></h2>
  <div class="field">
    <label for="wh_channels"><%= t("automod.whitelistChannels") %></label>
    <input type="text" id="wh_channels" name="wh_channels" value="<%= (settings.automod.wh_channels || []).join(', ') %>" />
  </div>
  <div class="field">
    <label for="spam_whitelist_roles"><%= t("automod.whitelistRoles") %></label>
    <input type="text" id="spam_whitelist_roles" name="spam_whitelist_roles" value="<%= (settings.automod.spam_whitelist_roles || []).join(', ') %>" />
    <div class="hint"><%= t("config.availableRoles", { roles: roles.map((r) => `${r.name} (${r.id})`).join(", ") || t("common.none") }) %></div>
  </div>
  <div class="field">
    <label for="spam_whitelist_users"><%= t("automod.whitelistUsers") %></label>
    <input type="text" id="spam_whitelist_users" name="spam_whitelist_users" value="<%= (settings.automod.spam_whitelist_users || []).join(', ') %>" />
  </div>

  <div class="form-actions"><span class="hint"><%= t("automod.saveHint") %></span><button type="submit" class="btn"><%= t("common.save") %></button></div>
</form>
<%- include("../partials/foot") %>
