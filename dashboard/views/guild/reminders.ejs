<%- include("../partials/head", { title, guild }) %>
<header class="page-header"><div class="page-heading">
  <p class="eyebrow"><%= t("reminders.eyebrow") %></p><h1><%= t("reminders.title") %></h1><p class="subtitle"><%= t("reminders.subtitle") %></p>
</div><span class="badge pass"><%= t("reminders.live") %></span></header>
<% if (error) { %><div class="error-banner"><%= error %></div><% } %>

<section class="panel collection-create">
  <h2><%= t("reminders.create") %></h2>
  <form method="post" action="<%= basePath %>/g/<%= guild.id %>/reminders" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="timezoneOffset" data-timezone-offset value="0" />
    <div class="field"><label for="reminder-channel"><%= t("common.channel") %></label><select id="reminder-channel" name="channelId" required><% channels.forEach((channel) => { %><option value="<%= channel.id %>">#<%= channel.name %></option><% }) %></select></div>
    <div class="field"><label for="reminder-at"><%= t("reminders.runAt") %></label><input id="reminder-at" type="datetime-local" name="runAt" required /></div>
    <div class="field"><label for="reminder-repeat"><%= t("reminders.repeat") %></label><input id="reminder-repeat" type="number" name="repeatMinutes" min="0" max="525600" value="0" /></div>
    <div class="field"><label for="reminder-mention"><%= t("reminders.mention") %></label><select id="reminder-mention" name="mention"><option value="CREATOR"><%= t("reminders.mentionCreator") %></option><option value="NONE"><%= t("reminders.mentionNone") %></option><option value="EVERYONE">@everyone</option><option value="HERE">@here</option></select></div>
    <div class="field"><label for="reminder-role"><%= t("reminders.mentionRole") %></label><select id="reminder-role" name="mentionRole"><option value=""><%= t("common.notSelected") %></option><% roles.forEach((role) => { %><option value="<%= role.id %>">@<%= role.name %></option><% }) %></select></div>
    <div class="field"><label for="reminder-color"><%= t("reminders.color") %></label><input id="reminder-color" type="color" name="color" value="#8b5cf6" /></div>
    <div class="field field-wide"><label for="reminder-title"><%= t("reminders.messageTitle") %></label><input id="reminder-title" name="title" maxlength="256" /></div>
    <div class="field field-wide"><label for="reminder-content"><%= t("reminders.content") %></label><textarea id="reminder-content" name="content" rows="5" maxlength="1000"></textarea></div>
    <div class="field"><label for="reminder-footer"><%= t("reminders.footer") %></label><input id="reminder-footer" name="footer" maxlength="2048" /></div>
    <div class="field"><label for="reminder-delete"><%= t("reminders.deleteAfter") %></label><input id="reminder-delete" type="number" name="deleteAfterSeconds" min="0" max="86400" value="0" /></div>
    <label class="checkbox-field field"><input type="checkbox" name="tts" /><span><%= t("reminders.tts") %></span></label>
    <label class="checkbox-field field"><input type="checkbox" name="crosspost" /><span><%= t("reminders.crosspost") %></span></label>
    <div class="field field-wide"><div class="hint"><%= t("reminders.crosspostHint") %></div></div>
    <div class="field field-wide"><hr /><p class="hint"><%= t("reminders.pollHint") %></p></div>
    <div class="field field-wide"><label for="reminder-poll-question"><%= t("reminders.pollQuestion") %></label><input id="reminder-poll-question" name="pollQuestion" maxlength="300" /></div>
    <div class="field field-wide"><label for="reminder-poll-options"><%= t("reminders.pollOptions") %></label><textarea id="reminder-poll-options" name="pollOptions" rows="3" placeholder="Yes&#10;No"></textarea></div>
    <label class="checkbox-field field"><input type="checkbox" name="pollMulti" /><span><%= t("reminders.pollMulti") %></span></label>
    <div class="field"><label for="reminder-poll-duration"><%= t("reminders.pollDuration") %></label><input id="reminder-poll-duration" type="number" name="pollDuration" min="1" /></div>
    <div class="field field-wide">
      <button class="btn secondary" type="submit" name="intent" value="preview"><%= t("reminders.preview") %></button>
      <button class="btn" type="submit" name="intent" value="create"><%= t("common.create") %></button>
    </div>
  </form>
  <% if (preview) { %>
    <div class="reminder-preview">
      <% if (preview.poll) { %>
        <p class="eyebrow"><%= t("reminders.previewTitle") %></p>
        <div class="embed-preview"><strong>📊 <%= preview.poll.question %></strong><ul><% preview.poll.options.forEach((entry) => { %><li><%= entry %></li><% }) %></ul></div>
      <% } else { %>
        <p class="eyebrow"><%= t("reminders.previewTitle") %></p>
        <div class="embed-preview" style="border-left-color: #<%= preview.embed.color ? preview.embed.color.toString(16).padStart(6, '0') : '5865f2' %>">
          <% if (preview.embed.author) { %><strong><%= preview.embed.author.name %></strong><% } %>
          <p><%= preview.embed.description %></p>
          <% if (preview.embed.footer) { %><small><%= preview.embed.footer.text %></small><% } %>
        </div>
      <% } %>
    </div>
  <% } %>
</section>

<section class="panel"><div class="section-heading"><div><p class="eyebrow"><%= t("reminders.queueEyebrow") %></p><h2><%= t("reminders.queue") %></h2></div></div>
  <form class="panel" method="get" action="<%= basePath %>/g/<%= guild.id %>/reminders">
    <div class="field"><label for="filter-channel"><%= t("common.channel") %></label><select id="filter-channel" name="channelId"><option value=""><%= t("eventRouter.anyChannel") %></option><% channels.forEach((channel) => { %><option value="<%= channel.id %>" <%= filterChannelId === channel.id ? "selected" : "" %>>#<%= channel.name %></option><% }) %></select></div>
    <div class="field"><label for="filter-creator"><%= t("reminders.filterCreator") %></label><input type="text" id="filter-creator" name="creatorId" value="<%= filterCreatorId || '' %>" /></div>
    <div class="field"><label for="filter-q"><%= t("common.search") %></label><input type="text" id="filter-q" name="q" value="<%= filterQuery || '' %>" /></div>
    <button type="submit" class="btn secondary"><%= t("common.filter") %></button>
  </form>
  <% if (!reminders.length) { %><div class="empty"><%= t("reminders.empty") %></div><% } else { %><div class="table-shell"><table><thead><tr><th><%= t("common.time") %></th><th><%= t("common.channel") %></th><th><%= t("reminders.content") %></th><th><%= t("reminders.repeat") %></th><th></th></tr></thead><tbody>
    <% reminders.forEach((reminder) => { %><tr><td><time datetime="<%= new Date(reminder.run_at).toISOString() %>"><%= new Date(reminder.run_at).toLocaleString(locale) %></time></td><td>#<%= (guild.channels.cache.get(reminder.payload.channelId) || {}).name || reminder.payload.channelId %></td><td><%= reminder.payload.poll?.question ? `📊 ${reminder.payload.poll.question}` : String(reminder.payload.content || "").slice(0, 140) %></td><td><%= reminder.payload.repeatMs ? Math.round(reminder.payload.repeatMs / 60000) + " min" : "—" %></td><td><form method="post" action="<%= basePath %>/g/<%= guild.id %>/reminders/<%= reminder._id %>/delete" data-confirm="<%= t('common.dangerousAction') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn danger" type="submit"><%= t("common.delete") %></button></form></td></tr><% }) %>
  </tbody></table></div>
  <% const pageQuery = `&channelId=${filterChannelId || ''}&creatorId=${filterCreatorId || ''}&q=${encodeURIComponent(filterQuery || '')}`; %>
  <div class="pagination">
    <% if (page > 1) { %><a class="btn secondary" href="?page=<%= page - 1 %><%= pageQuery %>"><%= t("common.back") %></a><% } %>
    <span><%= t("common.page", { page, total: totalPages }) %></span>
    <% if (page < totalPages) { %><a class="btn secondary" href="?page=<%= page + 1 %><%= pageQuery %>"><%= t("common.next") %></a><% } %>
  </div>
  <% } %>
</section>
<%- include("../partials/foot") %>
