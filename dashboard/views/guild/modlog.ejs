<%- include("../partials/head", { title, guild }) %>
<h1>ModLog</h1>

<form class="panel" method="get" action="<%= basePath %>/g/<%= guild.id %>/modlog">
  <div class="field">
    <label for="type">Тип</label>
    <select id="type" name="type">
      <option value="">Все</option>
      <% validTypes.forEach((t) => { %>
        <option value="<%= t %>" <%= filterType === t ? "selected" : "" %>><%= t %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="memberId">ID участника</label>
    <input type="text" id="memberId" name="memberId" value="<%= filterMemberId || '' %>" />
  </div>
  <button type="submit" class="btn secondary">Фильтровать</button>
</form>

<% if (entries.length === 0) { %>
  <div class="panel empty">Записей не найдено.</div>
<% } else { %>
  <table>
    <thead>
      <tr><th>Время</th><th>Тип</th><th>Участник</th><th>Модератор</th><th>Причина</th></tr>
    </thead>
    <tbody>
      <% entries.forEach((e) => { %>
        <tr>
          <td><%= new Date(e.created_at).toLocaleString("ru-RU") %></td>
          <td><%= e.type %></td>
          <td><a href="<%= basePath %>/g/<%= guild.id %>/members/<%= e.member_id %>"><%= e.member_id %></a></td>
          <td><%= e.admin?.tag || e.admin?.id %></td>
          <td><%= e.reason || "—" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="pagination">
    <% if (page > 1) { %><a class="btn secondary" href="?page=<%= page - 1 %>&type=<%= filterType || '' %>&memberId=<%= filterMemberId || '' %>">← Назад</a><% } %>
    <span>Стр. <%= page %> / <%= totalPages %></span>
    <% if (page < totalPages) { %><a class="btn secondary" href="?page=<%= page + 1 %>&type=<%= filterType || '' %>&memberId=<%= filterMemberId || '' %>">Вперёд →</a><% } %>
  </div>
<% } %>
<%- include("../partials/foot") %>
