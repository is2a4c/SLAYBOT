<%- include("../partials/head", { title }) %>
<header class="page-header"><div class="page-heading">
  <p class="eyebrow"><%= t("nav.owner") %></p>
  <h1><%= t("owner.staffRoles") %></h1>
  <p class="subtitle"><%= t("owner.staffHint") %></p>
</div></header>

<% if (error) { %><div class="error-banner"><%= error %></div><% } %>

<div class="table-shell"><table>
  <thead><tr><th><%= t("owner.discordId") %></th><th><%= t("common.role") %></th><th><%= t("owner.addedBy") %></th><th><%= t("owner.joinedAt") %></th><th></th></tr></thead>
  <tbody>
    <% if (accounts.length === 0) { %>
      <tr><td colspan="5" class="empty"><%= t("owner.staffEmpty") %></td></tr>
    <% } %>
    <% accounts.forEach((a) => { %>
      <tr>
        <td><%= a._id %></td>
        <td><%= a.role %></td>
        <td><%= a.addedBy %></td>
        <td><%= formatDate(a.added_at) %></td>
        <td>
          <form method="post" action="<%= basePath %>/owner/staff/<%= a._id %>/remove" data-confirm="<%= t("common.dangerousAction") %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn danger"><%= t("common.delete") %></button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<div class="panel">
  <h2 style="margin-top:0"><%= t("owner.addStaffHeading") %></h2>
  <form method="post" action="<%= basePath %>/owner/staff">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field">
      <label for="discordId"><%= t("owner.discordId") %></label>
      <input type="text" id="discordId" name="discordId" required />
    </div>
    <div class="field">
      <label for="role"><%= t("common.role") %></label>
      <select id="role" name="role">
        <% roles.forEach((r) => { %><option value="<%= r %>"><%= r %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn"><%= t("common.add") %></button>
  </form>
</div>
<%- include("../partials/foot") %>
