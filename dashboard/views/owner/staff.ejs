<%- include("../partials/head", { title }) %>
<h1>Staff-роли</h1>
<p class="hint">Владелец SLAYBOT (config.OWNER_IDS) всегда имеет полный доступ. Здесь выдаются права остальным сотрудникам.</p>

<% if (error) { %><div class="error-banner"><%= error %></div><% } %>

<table>
  <thead><tr><th>Discord ID</th><th>Роль</th><th>Добавил</th><th>Добавлен</th><th></th></tr></thead>
  <tbody>
    <% if (accounts.length === 0) { %>
      <tr><td colspan="5" class="empty">Staff-аккаунтов пока нет.</td></tr>
    <% } %>
    <% accounts.forEach((a) => { %>
      <tr>
        <td><%= a._id %></td>
        <td><%= a.role %></td>
        <td><%= a.addedBy %></td>
        <td><%= new Date(a.added_at).toLocaleDateString("ru-RU") %></td>
        <td>
          <form method="post" action="<%= basePath %>/owner/staff/<%= a._id %>/remove">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn danger">Удалить</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<div class="panel">
  <h2 style="margin-top:0">Добавить сотрудника</h2>
  <form method="post" action="<%= basePath %>/owner/staff">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field">
      <label for="discordId">Discord ID</label>
      <input type="text" id="discordId" name="discordId" required />
    </div>
    <div class="field">
      <label for="role">Роль</label>
      <select id="role" name="role">
        <% roles.forEach((r) => { %><option value="<%= r %>"><%= r %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn">Добавить</button>
  </form>
</div>
<%- include("../partials/foot") %>
