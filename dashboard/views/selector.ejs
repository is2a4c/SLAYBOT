<%- include("partials/head", { title }) %>
<h1>Мои серверы</h1>

<% if (guilds.length === 0) { %>
  <div class="panel empty">У вас нет серверов с правом Manage Server, где также состоит SLAYBOT.</div>
<% } else { %>
  <div class="list-card">
    <% guilds.forEach((g) => { %>
      <div class="list-row">
        <div class="guild-tile">
          <img src="<%= g.icon ? `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png?size=64` : "" %>" alt="" />
          <div>
            <div class="name"><%= g.name %></div>
            <div class="meta"><%= g.botPresent ? "SLAYBOT на сервере" : "SLAYBOT ещё не приглашён" %></div>
          </div>
        </div>
        <% if (g.botPresent) { %>
          <a class="btn" href="<%= basePath %>/g/<%= g.id %>">Открыть</a>
        <% } else { %>
          <a class="btn secondary" href="<%= g.inviteUrl %>" target="_blank" rel="noopener">Пригласить</a>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (isOwnerUser) { %>
  <p><a href="<%= basePath %>/owner">→ Owner Control Center</a></p>
<% } %>
<%- include("partials/foot") %>
