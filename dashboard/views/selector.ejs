<%- include("partials/head", { title }) %>
<header class="page-header">
  <div class="page-heading">
    <p class="eyebrow"><%= t("selector.eyebrow") %></p>
    <h1><%= t("selector.title") %></h1>
    <p class="subtitle"><%= t("selector.subtitle") %></p>
  </div>
  <span class="badge pass"><%= t("selector.serverCount", { count: guilds.length }) %></span>
</header>

<% if (guilds.length === 0) { %>
  <div class="panel empty"><%= t("selector.empty") %></div>
<% } else { %>
  <div class="guild-grid">
    <% guilds.forEach((g) => { %>
      <article class="guild-card">
        <div class="guild-tile">
          <% if (g.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=96" alt="" />
          <% } else { %>
            <span class="guild-avatar workspace-fallback"><%= g.name.slice(0, 1).toUpperCase() %></span>
          <% } %>
          <div>
            <div class="name"><%= g.name %></div>
            <div class="meta"><%= g.botPresent ? t("selector.botPresent") : t("selector.botMissing") %></div>
          </div>
        </div>
        <% if (g.botPresent) { %>
          <a class="btn" href="<%= basePath %>/g/<%= g.id %>"><%= t("common.open") %></a>
        <% } else { %>
          <a class="btn secondary" href="<%= g.inviteUrl %>" target="_blank" rel="noopener"><%= t("common.invite") %></a>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } %>
<%- include("partials/foot") %>
