<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " — SLAYBOT" : "SLAYBOT" %></title>
  <link rel="stylesheet" href="<%= basePath %>/style.css" />
  <script src="<%= basePath %>/dashboard.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a href="<%= basePath %>/" class="brand">SLAYBOT</a>
    <nav>
      <% if (typeof guild !== "undefined" && guild) { %>
        <a href="<%= basePath %>/g/<%= guild.id %>"><%= t("nav.overview") %></a>
        <% if (typeof canGuild === "function" && canGuild("config.edit")) { %><a href="<%= basePath %>/g/<%= guild.id %>/config"><%= t("nav.config") %></a><% } %>
        <% if (typeof canGuild === "function" && canGuild("automod.edit")) { %><a href="<%= basePath %>/g/<%= guild.id %>/automod"><%= t("nav.automod") %></a><% } %>
        <% if (typeof canGuild === "function" && canGuild("audit.view")) { %><a href="<%= basePath %>/g/<%= guild.id %>/modlog"><%= t("nav.modlog") %></a><% } %>
        <% if (typeof canGuild === "function" && canGuild("smartinvites.manage")) { %><a href="<%= basePath %>/g/<%= guild.id %>/smart-invites"><%= t("nav.smartInvites") %></a><% } %>
        <% if (typeof canGuild === "function" && canGuild("diagnostics.run")) { %><a href="<%= basePath %>/g/<%= guild.id %>/diagnostics"><%= t("nav.diagnostics") %></a><% } %>
        <% if (typeof canGuild === "function" && canGuild("audit.view")) { %><a href="<%= basePath %>/g/<%= guild.id %>/audit"><%= t("nav.audit") %></a><% } %>
        <a href="<%= basePath %>/"><%= t("nav.myServers") %></a>
      <% } %>
      <% if (locals.canAccessOwner === true) { %>
        <a href="<%= basePath %>/owner"><%= t("nav.owner") %></a>
      <% } %>
    </nav>
    <% if (locals.sessionUser) { %>
      <form method="post" action="<%= basePath %>/auth/logout" class="logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <span class="username"><%= sessionUser.username %></span>
        <button type="submit" class="link-button"><%= t("common.logout") %></button>
      </form>
    <% } %>
    <span class="lang-switch" aria-label="<%= t("common.language") %>">
      <% locales.forEach((entry) => { %><a href="?lang=<%= entry.code %>" class="<%= entry.active ? "active" : "" %>"><%= entry.code.toUpperCase() %></a><% }) %>
    </span>
  </header>
  <main class="content">
