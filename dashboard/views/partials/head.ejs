<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " — SLAYBOT" : "SLAYBOT" %></title>
  <link rel="stylesheet" href="<%= basePath %>/style.css" />
  <script src="<%= basePath %>/dashboard.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a href="<%= basePath %>/" class="brand">SLAYBOT</a>
    <nav>
      <% if (typeof guild !== "undefined" && guild) { %>
        <a href="<%= basePath %>/g/<%= guild.id %>">Обзор</a>
        <a href="<%= basePath %>/g/<%= guild.id %>/config">Настройки</a>
        <a href="<%= basePath %>/g/<%= guild.id %>/automod">Automod</a>
        <a href="<%= basePath %>/g/<%= guild.id %>/modlog">ModLog</a>
        <a href="<%= basePath %>/g/<%= guild.id %>/smart-invites">Smart Invites</a>
        <a href="<%= basePath %>/g/<%= guild.id %>/diagnostics">Диагностика</a>
        <a href="<%= basePath %>/g/<%= guild.id %>/audit">Audit Log</a>
        <a href="<%= basePath %>/">← Мои серверы</a>
      <% } %>
      <% if (locals.isOwnerUser) { %>
        <a href="<%= basePath %>/owner">Owner</a>
      <% } %>
    </nav>
    <% if (locals.sessionUser) { %>
      <form method="post" action="<%= basePath %>/auth/logout" class="logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <span class="username"><%= sessionUser.username %></span>
        <button type="submit" class="link-button">Выйти</button>
      </form>
    <% } %>
  </header>
  <main class="content">
